{
  "id": "/entropyweb.html",
  "name": "EntroPy Password Generator project - Web Version",
  "short_name": "EntroPy Web",
  "description": "The web browser version of the EntroPy Password Generator, real-time, 100% secure and 100% interactive!",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/entropyweb.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0a14",
  "theme_color": "#0a0a14",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    {
      "src": "/favicon-256x256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-871x874.png",
      "sizes": "871x874",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
